--- a/prereq_test.go
+++ b/prereq_test.go
@@ -20,5 +20,43 @@ import (
 	"fmt"
 	"os"
+	"path/filepath"
+	"testing"
 )
 
+// Trustant regression for a failed upgrade with a cached executable.
+func TestFailedPrerequisiteKeepsInstalledVersion(t *testing.T) {
+	bindir := t.TempDir()
+	t.Setenv("OPS_BIN", bindir)
+
+	dryRun, oldSeen := taskDryRun, PrereqSeenMap
+	taskDryRun, PrereqSeenMap = false, map[string]string{}
+	t.Cleanup(func() {
+		taskDryRun, PrereqSeenMap = dryRun, oldSeen
+	})
+
+	executable := filepath.Join(bindir, addExeExt("sample"))
+	oldMarker := executable + "-1"
+	if err := os.WriteFile(executable, []byte("old executable"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(oldMarker, nil, 0644); err != nil {
+		t.Fatal(err)
+	}
+	// The test executable rejects the installer subprocess's -task flag.
+	for range 2 {
+		if err := downloadPrereq("sample", "2"); err == nil {
+			t.Fatal("failed installer succeeded")
+		}
+	}
+	if _, err := os.Stat(oldMarker); err != nil {
+		t.Fatalf("old version marker: %v", err)
+	}
+	if _, err := os.Stat(executable + "-2"); !os.IsNotExist(err) {
+		t.Fatalf("unexpected new version marker: %v", err)
+	}
+	if contents, err := os.ReadFile(executable); err != nil || string(contents) != "old executable" {
+		t.Fatalf("old executable changed: %q, %v", contents, err)
+	}
+}
