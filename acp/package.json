{
	"name": "trustant-acp",
	"version": "0.11.0",
	"description": "Standalone ACP client — use AI coding agents via the Agent Client Protocol",
	"scripts": {
		"dev": "bash run.sh",
		"setup:agents": "bash setup.sh",
		"serve": "tsx server/index.ts",
		"serve:trureact": "tsx server/index.ts --port 4097",
		"acp": "tsx server/index.ts --cli",
		"build:web": "node esbuild.web.mjs production",
		"dev:web": "node esbuild.web.mjs",
		"start": "node esbuild.web.mjs production && tsx server/index.ts",
		"build:server": "node esbuild.server.mjs",
		"build": "npm run build:web && npm run build:server",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
		"lint": "npm --prefix .. run lint:web -- acp",
		"lint:fix": "npm --prefix .. run lint:web -- --write acp"
	},
	"keywords": [],
	"author": "",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/react": "18.3.29",
		"@types/react-dom": "18.3.7",
		"@types/semver": "^7.7.1",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.28.1",
		"prettier": "^3.4.2",
		"tslib": "2.4.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.28.1",
		"@tanstack/react-virtual": "^3.13.23",
		"diff": "^8.0.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"semver": "^7.7.3",
		"ws": "^8.21.1",
		"zod": "^4.4.3"
	}
}
