{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"obsidian": ["./obsidian-legacy/node_modules/obsidian"],
			"@codemirror/state": ["./obsidian-legacy/node_modules/@codemirror/state"],
			"@codemirror/view": ["./obsidian-legacy/node_modules/@codemirror/view"]
		},
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"jsx": "react-jsx"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
