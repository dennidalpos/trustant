# pi.version — pinned npm install specs for the coding agents and their ACP
# adapters. setup.sh reads this file and installs exactly these specs, so image
# builds are reproducible instead of drifting with upstream releases.
#
# Format: one literal npm install spec per line, `<module>@<version>`.
# Every line MUST carry a version — setup.sh aborts on an unpinned entry.
# Blank lines and `#` comments are ignored. Update the reviewed SRI in
# pi.integrity when changing an integrity pin.

# Claude Code is NOT listed here on purpose: everything in this file ends up
# in the published image, and Claude Code is proprietary. Its pins live in
# server/claude-version.ts and TruACP installs it on demand after the user
# accepts Anthropic's Commercial Terms.

# Codex — CLI + ACP adapter
# (@zed-industries/codex-acp is deprecated in favour of the
#  @agentclientprotocol scope; same codex-acp bin, drop-in.)
@openai/codex@0.171.0
@agentclientprotocol/codex-acp@2.12.0

# Pi CLI and core — exact upstream release. setup.sh verifies the four package
# integrities recorded in pi.integrity before installing them as one lockstep
# runtime. Trustant-specific stream protection lives in the managed extension.
@earendil-works/pi-ai@1.6.0
@earendil-works/pi-tui@1.6.0
@earendil-works/pi-agent-core@1.6.0
@earendil-works/pi-coding-agent@1.6.0

# Pi extensions — setup.sh registers these with `pi install`; a plain global
# npm installation would put their files on disk without activating them.
# pi-web-access additionally needs a search-provider key configured in Pi.
pi-mcp-adapter@7.0.1
pi-web-access@0.48.0
